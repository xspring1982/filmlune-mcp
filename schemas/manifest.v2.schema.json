{
  "$defs": {
    "change": {
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "pattern": "^cev_[0-9]{4}$",
          "type": "string"
        },
        "caseRevisionId": {
          "pattern": "^cev_[0-9]{4}@r[0-9]{4}$",
          "type": "string"
        },
        "changedAtUtc": {
          "format": "date-time",
          "type": "string"
        },
        "changeId": {
          "minLength": 1,
          "type": "string"
        },
        "changeKind": {
          "enum": [
            "upserted",
            "removed"
          ]
        },
        "provenance": {
          "$ref": "#/$defs/provenance"
        }
      },
      "required": [
        "caseId",
        "caseRevisionId",
        "changeId",
        "changeKind",
        "changedAtUtc",
        "provenance"
      ],
      "type": "object"
    },
    "file": {
      "additionalProperties": false,
      "properties": {
        "path": {
          "not": {
            "const": "catalog/manifest.json"
          },
          "pattern": "^(?:catalog|schemas)/[a-z0-9_./-]+\\.json$",
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "path",
        "sha256"
      ],
      "type": "object"
    },
    "generator": {
      "additionalProperties": false,
      "properties": {
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "version": {
          "enum": [
            "mcp-catalog-v2",
            "mcp-catalog-v3"
          ]
        }
      },
      "required": [
        "sha256",
        "version"
      ],
      "type": "object"
    },
    "presentation": {
      "additionalProperties": false,
      "properties": {
        "language": {
          "const": "en"
        },
        "revision": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "language",
        "revision",
        "sha256"
      ],
      "type": "object"
    },
    "provenance": {
      "additionalProperties": false,
      "properties": {
        "generatorSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "generatorVersion": {
          "minLength": 1,
          "type": "string"
        },
        "presentationRevision": {
          "minLength": 1,
          "type": "string"
        },
        "presentationSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "websiteSourceRevision": {
          "minLength": 1,
          "type": "string"
        },
        "websiteSourceSha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "generatorSha256",
        "generatorVersion",
        "presentationRevision",
        "presentationSha256",
        "websiteSourceRevision",
        "websiteSourceSha256"
      ],
      "type": "object"
    },
    "schemaHashes": {
      "additionalProperties": false,
      "properties": {
        "caseV2": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "manifestV2": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "tombstoneV1": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        }
      },
      "required": [
        "caseV2",
        "manifestV2",
        "tombstoneV1"
      ],
      "type": "object"
    },
    "source": {
      "additionalProperties": false,
      "properties": {
        "revision": {
          "minLength": 1,
          "type": "string"
        },
        "sha256": {
          "pattern": "^[a-f0-9]{64}$",
          "type": "string"
        },
        "websiteRepository": {
          "const": "filmlune.com"
        }
      },
      "required": [
        "revision",
        "sha256",
        "websiteRepository"
      ],
      "type": "object"
    }
  },
  "$id": "https://filmlune.com/schemas/mcp/manifest.v2.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Hash-bound manifest for one generated English MCP catalog revision.",
  "properties": {
    "activeIds": {
      "items": {
        "pattern": "^cev_[0-9]{4}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    },
    "catalogRevision": {
      "minLength": 1,
      "type": "string"
    },
    "changes": {
      "items": {
        "$ref": "#/$defs/change"
      },
      "type": "array",
      "uniqueItems": true
    },
    "files": {
      "items": {
        "$ref": "#/$defs/file"
      },
      "minItems": 5,
      "type": "array",
      "uniqueItems": true
    },
    "generator": {
      "$ref": "#/$defs/generator"
    },
    "modelsSha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "presentation": {
      "$ref": "#/$defs/presentation"
    },
    "schemaHashes": {
      "$ref": "#/$defs/schemaHashes"
    },
    "schemaVersion": {
      "const": 2
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "taxonomySha256": {
      "pattern": "^[a-f0-9]{64}$",
      "type": "string"
    },
    "tombstoneIds": {
      "items": {
        "pattern": "^cev_[0-9]{4}$",
        "type": "string"
      },
      "type": "array",
      "uniqueItems": true
    }
  },
  "required": [
    "schemaVersion",
    "catalogRevision",
    "generator",
    "presentation",
    "source",
    "files",
    "activeIds",
    "tombstoneIds",
    "changes",
    "schemaHashes",
    "modelsSha256",
    "taxonomySha256"
  ],
  "title": "FilmLune MCP catalog manifest v2",
  "type": "object"
}
